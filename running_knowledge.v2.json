{
  "schemaVersion": "running-knowledge.v2",
  "version": "2.2.0",
  "updated": "2026-09-14",
  "domain": "running",
  "canonicalIndex": "running_canonical_knowledge_index",
  "canonicalContract": "running_canonical_measurement_contract",
  "evidenceAxes": {
    "vault": "1-5 source and provenance hierarchy",
    "running": {
      "A": "camera-derived measurement or explicitly named proxy",
      "B": "multi-stride pattern derived from Level A measurements",
      "C": "bounded biomechanical interpretation",
      "D": "myofascial hypothesis requiring clinical correlation"
    }
  },
  "captureContract": {
    "modes": [
      "uploaded_video_pose_analysis",
      "recorded_video_pose_analysis",
      "manual_event_review"
    ],
    "eventPolicy": "automatic candidates require confidence, supporting signals, and manual review availability",
    "maxDurationSeconds": 45,
    "preferredFrameRate": 60,
    "provisionalMinimumFrameRate": 30,
    "preferredView": "side",
    "minimumCompleteSameSideCycles": 3,
    "preferredValidStrideCount": 10,
    "requiredMetadata": [
      "view",
      "environment",
      "reportedFrameRate",
      "decodedSourceWidth",
      "decodedSourceHeight",
      "runningDirection",
      "trialLabel"
    ],
    "note": "Running-specific thresholds and automatic event detection remain provisional until validated against annotated running video. Do not inherit generic, gait, or squat thresholds silently."
  },
